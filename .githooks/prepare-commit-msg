#!/bin/sh
MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0
if sed --version >/dev/null 2>&1; then
  sed -i \
    -e '/^Co-authored-by:.*[Cc]ursor/d' \
    -e '/^Co-authored-by:.*cursoragent@/d' \
    -e '/^Co-authored-by:.*[Cc]laude/d' \
    "$MSG_FILE"
else
  sed -i '' \
    -e '/^Co-authored-by:.*[Cc]ursor/d' \
    -e '/^Co-authored-by:.*cursoragent@/d' \
    -e '/^Co-authored-by:.*[Cc]laude/d' \
    "$MSG_FILE"
fi
exit 0
